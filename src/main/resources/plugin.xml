<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>
<plugin>
    <!-- Two webapp contexts: the REST API, and the React app - which serves both the Vite bundle and
         the administration-menu icons. One extension element holds them, as Polarion's own
         com.polarion.alm.ui does. -->
    <extension
            point="com.polarion.portal.tomcat.webapps">
        <webapp
                name="polarion/requirements-inspector"
                contextRoot="webapp/requirements-inspector">
        </webapp>
        <webapp
                name="polarion/requirements-inspector-app"
                contextRoot="webapp/requirements-inspector-app">
        </webapp>
    </extension>
</plugin>
